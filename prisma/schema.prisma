
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Blog {
  id          String @id
  title       String
  excerpt     String
  category    String
  authorName  String @map("author_name")
  publishedAt String @map("published_at")
  image       String
  imageAlt    String @map("image_alt")
  likes       Int    @default(0)
  content     String

  @@index([publishedAt], map: "idx_blogs_published_at")
  @@index([category], map: "idx_blogs_category")

  @@map("blogs")
}

model Project {
  id       String @id
  category String

  location         String?
  plant            String?
  capacity         String?
  yearOfAward      String? @map("year_of_award")
  yearOfCompletion String? @map("year_of_completion")
  contractValue    String? @map("contract_value")
  executionScope   String? @map("execution_scope")

  heroEyebrow     String @map("hero_eyebrow")
  heroHeading     String @map("hero_heading")
  heroDescription String @map("hero_description")
  heroImage       String @map("hero_image")
  heroImageAlt    String @map("hero_image_alt")

  overviewHeadingBefore    String  @map("overview_heading_before")
  overviewHeadingHighlight String? @map("overview_heading_highlight")
  overviewHeadingAfter     String  @default("") @map("overview_heading_after")
  overviewDescription      String  @map("overview_description")
  overviewImage            String? @map("overview_image")
  overviewImageAlt         String? @map("overview_image_alt")

  problemHeading     String? @map("problem_heading")
  problemDescription String? @map("problem_description")
  problemImage       String? @map("problem_image")
  problemImageAlt    String? @map("problem_image_alt")

  solutionHeading     String  @map("solution_heading")
  solutionDescription String  @map("solution_description")
  solutionImage       String? @map("solution_image")
  solutionImageAlt    String? @map("solution_image_alt")
  solutionPoints      String  @default("[]") @map("solution_points")

  resultHeading     String? @map("result_heading")
  resultDescription String? @map("result_description")
  resultPoints      String? @map("result_points")

  @@index([category], map: "idx_projects_category")
  @@map("projects")
}

model Sbu {
  slug         String @id
  number       String
  name         String
  eyebrow      String
  offerings    String
  image        String
  imageAlt     String @map("image_alt")
  capabilities String @default("[]")
  displayOrder Int    @default(0) @map("display_order")

  navigationGroups SbuNavigationGroup[]
  solutions        Solution[]

  @@index([displayOrder], map: "idx_sbus_display_order")
  @@map("sbus")
}

model SbuNavigationGroup {
  slug         String @id
  sbuSlug      String @map("sbu_slug")
  title        String
  eyebrow      String
  tagline      String
  description  String
  overview     String
  image        String
  displayOrder Int    @default(0) @map("display_order")

  sbu       Sbu        @relation(fields: [sbuSlug], references: [slug], onDelete: Cascade)
  solutions Solution[]

  @@index([sbuSlug, displayOrder], map: "idx_sbu_groups_sbu_order")
  @@map("sbu_navigation_groups")
}

model Solution {
  id              String  @id
  sbuSlug         String  @map("sbu_slug")
  groupSlug       String? @map("group_slug")
  slug            String
  heroName        String  @map("hero_name")
  heroTagline     String  @map("hero_tagline")
  heroDescription String  @map("hero_description")
  heroImage       String? @map("hero_image")
  heroImageAlt    String? @map("hero_image_alt")
  sections        String  @default("[]")
  displayOrder    Int     @default(0) @map("display_order")

  sbu   Sbu                 @relation(fields: [sbuSlug], references: [slug], onDelete: Cascade)
  group SbuNavigationGroup? @relation(fields: [groupSlug], references: [slug], onDelete: SetNull)

  @@unique([sbuSlug, slug], map: "uq_solutions_sbu_slug")
  @@index([sbuSlug, displayOrder], map: "idx_solutions_sbu_order")
  @@index([groupSlug, displayOrder], map: "idx_solutions_group_order")
  @@map("solutions")
}
